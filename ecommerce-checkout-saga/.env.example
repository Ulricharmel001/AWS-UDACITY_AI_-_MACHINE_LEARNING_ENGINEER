# ─────────────────────────────────────────────────────────────────────────────
# Lesson 7 Exercise Solution: E-Commerce Checkout Saga
#
# Copy this file to .env and fill in any values you need.
# The .env file is gitignored — never commit real credentials.
#
# Credentials are provided by the "Load AWS Credentials" sidebar. Do not put
# access keys, secret keys, or session tokens in this template.
#
# Deploy infrastructure first (creates the DynamoDB saga-state table):
#   aws cloudformation deploy --template-file infrastructure/stack.yaml \
#       --stack-name lesson-07-exercise-saga
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS / Bedrock Settings ───────────────────────────────────────────────────
# Use the cross-region inference profile prefix (us.) for Nova models —
# on-demand throughput requires an inference profile, not a bare model ID.
AWS_REGION=us-west-1
NOVA_LITE_MODEL=us.amazon.nova-lite-v1:0

# ── DynamoDB Table (from CloudFormation outputs) ─────────────────────────────
CHECKOUT_SAGA_TABLE=lesson-07-saga-checkout-saga
